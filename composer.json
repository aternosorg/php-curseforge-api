{
    "name": "aternos/curseforge-api",
    "type": "library",
    "description": "PHP Client for the CurseForge API. This client is based on the openapi spec.",
    "keywords": [
        "curseforge",
        "mods",
        "plugins",
        "minecraft",
        "php",
        "api"
    ],
    "homepage": "https://github.com/aternosorg/php-curseforge-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Aternos GmbH",
            "homepage": "https://aternos.gmbh"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.2",
        "guzzlehttp/psr7": "^2.12.3 || ^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.39"
    },
    "autoload": {
        "psr-4": {
            "Aternos\\CurseForgeApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aternos\\CurseForgeApi\\Tests\\": "tests/"
        }
    }
}
